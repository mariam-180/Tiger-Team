# DB specific env variables
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_HOST=    # Use the service name of the DB container as the host within Docker network
MYSQL_PORT=3306

# Service specific env variables
ENV=  # 'production', 'development', 'staging', etc., depending on your environment

# Logger env variables
LOG_DIRECTORY=/app/logs
LOG_HOST_DIRECTORY=/var/log/backEnd